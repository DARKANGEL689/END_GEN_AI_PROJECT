# Database (Neon PostgreSQL with pgvector support)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="super-secret-random-32-character-key-here"

# Web Intelligence: Firecrawl
FIRECRAWL_API_KEY="" # Format: fc-... (Leave empty to use verified mock/fixture mode)
FIRECRAWL_API_URL="https://api.firecrawl.dev"

# LLM Providers (Vercel AI SDK)
# Option A: Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=""

# Option B: OpenAI
OPENAI_API_KEY=""

# Active LLM Provider Selection: "google" | "openai" | "synthetic-offline"
ACTIVE_LLM_PROVIDER="google"

# Memory Provider: "local" | "memento" | "mem0"
MEMORY_PROVIDER="local"
MEM0_API_KEY="" # Optional, if connecting external Mem0

# Demo Mode & Safety Guardrails
DEMO_MODE="true" # Enforces SYNTHETIC DATA watermark and safe sandbox
